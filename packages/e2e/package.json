{
  "name": "e2e",
  "version": "0.0.0-dev",
  "main": "index.js",
  "scripts": {
    "e2e": "test-with-playwright --only-extension=. --test-path=.",
    "e2e:firefox": "test-with-playwright --only-extension=. --test-path=. --browser=firefox",
    "e2e:firefox:headless": "test-with-playwright --only-extension=. --test-path=. --browser=firefox --headless",
    "e2e:headless": "test-with-playwright --only-extension=. --test-path=. --headless",
    "e2e:webkit": "test-with-playwright --only-extension=. --test-path=. --browser=webkit",
    "e2e:webkit:diagnostic": "node ./scripts/patch-playwright-page-logging.js && test-with-playwright --only-extension=. --test-path=. --browser=webkit --headless --filter=find-widget-open.ts",
    "e2e:webkit:headless": "test-with-playwright --only-extension=. --test-path=. --browser=webkit --headless",
    "type-check": "tsc"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@lvce-editor/test-with-playwright": "^22.17.0"
  }
}
