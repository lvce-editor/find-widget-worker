{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "DOM"],
    "checkJs": true,
    "module": "nodenext",
    "types": [],
    "moduleResolution": "nodeNext",
    "rootDir": ".",
    "allowJs": true,
    "skipLibCheck": false,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "assumeChangesOnlyAffectDirectDependencies": true,
    "strict": true,
    "noImplicitAny": false,
    "composite": true,
    "noUnusedParameters": true
  },
  "include": ["isolated/src", "src", "test"]
}
